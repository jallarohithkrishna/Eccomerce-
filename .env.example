# Firebase Client SDK Credentials
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_AI_SERVER_URL=http://localhost:5000
VITE_USE_EMULATOR=false

# Server Security & Secret Keys (Required in production; server refuses to start without them)
COURIER_TOKEN_SECRET=your_courier_token_secret_here
CARRIER_WEBHOOK_SECRET=your_carrier_webhook_secret_here

# AI & LLM Provider Credentials
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_llm_or_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini

# Server & Environment Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
ALLOW_DEV_AUTH=0
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
