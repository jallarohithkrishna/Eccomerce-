rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ORDERS ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Helper: check if current user owns this order
      function isOrderOwner() {
        return request.auth != null && (
          resource.data.customer.user_id == request.auth.uid ||
          resource.data.user_id == request.auth.uid
        );
      }

      allow read: if isOrderOwner();

      // Owner can update their own order (e.g. submit return, mark delivered)
      allow update: if isOrderOwner();

      // Any authenticated user can create an order (during checkout)
      allow create: if request.auth != null;

      // Allow delete by owner (optional, for cleanup)
      allow delete: if isOrderOwner();
    }

    // ── RETURNS ─────────────────────────────────────────────────────────────
    match /returns/{returnId} {
      function isReturnOwner() {
        return request.auth != null &&
          resource.data.user_id == request.auth.uid;
      }

      allow read: if isReturnOwner();

      allow create: if request.auth != null;

      allow update: if isReturnOwner();
    }

    // ── PRODUCTS ────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.admin == true;
    }

    // ── USERS ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
    }

    // ── CATEGORIES ──────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.admin == true;
    }
  }
}

