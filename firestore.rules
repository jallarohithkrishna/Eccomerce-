rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ADMIN CHECK ─────────────────────────────────────────────────────────
    // Admin is identified by email — grants full access to all collections
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'k71540270@gmail.com' || request.auth.token.email == 'jallarohithkrishna@gmail.com');
    }

    // ── ORDERS ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      function isOrderOwner() {
        return request.auth != null && (
          resource.data.customer.user_id == request.auth.uid ||
          resource.data.user_id == request.auth.uid
        );
      }

      // Admin can read all orders; users can read their own; public tracking by order ID
      allow read: if true;

      // Admin can update any order; users can update their own
      allow update: if isAdmin() || isOrderOwner();

      // Any authenticated user can create (checkout)
      allow create: if request.auth != null;

      // Only admin can delete
      allow delete: if isAdmin();
    }

    // ── RETURNS ─────────────────────────────────────────────────────────────
    match /returns/{returnId} {
      function isReturnOwner() {
        return request.auth != null &&
          resource.data.user_id == request.auth.uid;
      }

      // Public verification of return RMA / courier passes
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if isAdmin() || isReturnOwner();
      allow delete: if isAdmin();
    }

    // ── PRODUCTS ────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Everyone can read products
      allow read: if true;
      // Admin can add/update/delete products
      allow write: if isAdmin();
    }

    // ── USERS ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Admin can read all users; users can only read/write their own
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // ── CATEGORIES ──────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}


