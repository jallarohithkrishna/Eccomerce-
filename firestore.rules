rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── AUTHENTICATION & ROLE HELPERS ──────────────────────────────────────────
    // All roles come exclusively from Firebase Auth custom claims (request.auth.token.role)
    // No hardcoded emails or client-controlled role overrides permitted.
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.get('role', '') == role;
    }

    function hasAnyRole(roles) {
      return isSignedIn() && request.auth.token.get('role', '') in roles;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStaff() {
      return hasAnyRole(['admin', 'staff']);
    }

    function isWarehouse() {
      return hasAnyRole(['admin', 'warehouse']);
    }

    function isAnyStaff() {
      return hasAnyRole(['admin', 'staff', 'warehouse']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── ORDERS ───────────────────────────────────────────────────────────────
    // Only the order owner or staff can read orders.
    // Client can create orders at checkout, but cannot mutate delivered_at or returns.
    // Client cannot update orders directly (server handles state changes).
    match /orders/{orderId} {
      function isOrderOwner() {
        return isSignedIn() && (
          resource.data.customer.user_id == request.auth.uid ||
          resource.data.user_id == request.auth.uid
        );
      }

      allow read: if isStaff() || isOrderOwner();

      // Create allowed for authenticated users for their own order without delivered_at, returns, or unauthorized status
      allow create: if isSignedIn() && (
        (request.resource.data.customer.user_id == request.auth.uid || request.resource.data.user_id == request.auth.uid) &&
        !('delivered_at' in request.resource.data) &&
        !('returns' in request.resource.data) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'processing'])
      );

      // Only staff can update orders via client (server uses Admin SDK which bypasses rules)
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── RETURNS & SUBCOLLECTIONS ─────────────────────────────────────────────
    // Single source of truth for return requests.
    // Customers can read only their own returns.
    // All create/update operations are executed exclusively by the Server Orchestrator (Admin SDK).
    match /returns/{returnId} {
      function isReturnOwner() {
        let parentDoc = get(/databases/$(database)/documents/returns/$(returnId)).data;
        return isSignedIn() && (
          (resource != null && resource.data != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
          (resource != null && resource.data != null && 'user_id' in resource.data && resource.data.user_id == request.auth.uid) ||
          (parentDoc != null && 'userId' in parentDoc && parentDoc.userId == request.auth.uid) ||
          (parentDoc != null && 'user_id' in parentDoc && parentDoc.user_id == request.auth.uid) ||
          (parentDoc != null && 'customer' in parentDoc && parentDoc.customer.user_id == request.auth.uid)
        );
      }

      // Read restricted to case owner or authorized staff/warehouse
      allow read: if isStaff() || isWarehouse() || isReturnOwner();

      // Client writes are completely disabled — only Server Admin SDK writes returns
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      // Append-only audit events subcollection: SHA-256 chained events written only by server
      match /events/{seq} {
        allow read: if isStaff() || isWarehouse() || isReturnOwner();
        allow write: if false;
      }

      // Customer / Staff communication messages subcollection
      match /messages/{messageId} {
        allow read: if isStaff() || isReturnOwner();
        allow write: if false;
      }

      // Evidence records subcollection
      match /evidence/{evidenceId} {
        allow read: if isStaff() || isWarehouse() || isReturnOwner();
        allow write: if false;
      }
    }

    // ── REFUNDS ──────────────────────────────────────────────────────────────
    // Idempotent refund records written exclusively by the Server Orchestrator.
    match /refunds/{refundId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ── PRODUCTS ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
        allow update, delete: if isStaff();
      }
    }

    // ── CATEGORIES ───────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── POLICIES ─────────────────────────────────────────────────────────────
    match /policies/{version} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    // Users can read/update their own profile, but CANNOT self-escalate their role field.
    match /users/{userId} {
      allow read: if isStaff() || isOwner(userId);
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || request.resource.data.role == 'customer'
      );
      allow update: if isStaff() || (
        isOwner(userId) && (
          !('role' in request.resource.data) || request.resource.data.role == resource.data.role
        )
      );
      allow delete: if isAdmin();
    }
  }
}
